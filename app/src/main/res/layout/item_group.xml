<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="8dp"
        android:background="@drawable/round_white_background"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="分组名称"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_confirm"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="确认排序"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/check"
                android:visibility="gone"
                app:tint="@color/icon_primary" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="刷新"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/refresh"
                app:tint="@color/icon_primary" />

            <ImageButton
                android:id="@+id/btn_add"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="添加"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/app_add"
                app:tint="@color/icon_primary" />

            <ImageButton
                android:id="@+id/btn_move"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="移动"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/group_sort"
                app:tint="@color/icon_primary" />

            <ImageButton
                android:id="@+id/btn_tune"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/tune"
                app:tint="@color/icon_primary" />

            <ImageButton
                android:id="@+id/btn_batch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/group_batch_menu_title"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder_open"
                app:tint="@color/icon_primary" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:id="@+id/expand_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pressed_background">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/chevron_down"
                    app:tint="@color/icon_secondary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/empty_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pressed_background"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/plus"
                    app:tint="@color/icon_secondary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/app_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_margin="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/group_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
