<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/group_app_item_height"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:padding="@dimen/group_app_item_padding">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/group_app_icon_size"
        android:layout_height="@dimen/group_app_icon_size"
        android:contentDescription="@string/desc_app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 运行状态指示器在图标右上角 -->
    <ImageView
        android:id="@+id/app_run_indicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@string/desc_app_running"
        android:src="@drawable/ic_running_indicator"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/app_icon"
        app:layout_constraintTop_toTopOf="@id/app_icon" />

    <!-- Lock指示器在图标右下角 -->
    <ImageView
        android:id="@+id/app_lock_indicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@string/desc_app_lock"
        android:src="@drawable/lock_outline"
        android:visibility="gone"
        app:tint="@color/status_warning"
        app:layout_constraintEnd_toEndOf="@id/app_icon"
        app:layout_constraintBottom_toBottomOf="@id/app_icon" />

    <TextView
        android:id="@+id/app_name"
        android:layout_width="0dp"
        android:layout_height="@dimen/group_app_name_height"
        android:layout_marginTop="@dimen/group_app_name_margin_top"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:maxLines="2"
        tools:text="App" android:text=""
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_icon" />

    <!-- 状态指示器 -->
    <ImageView
        android:id="@+id/app_status_indicator"
        android:layout_width="@dimen/group_app_status_size"
        android:layout_height="@dimen/group_app_status_size"
        android:layout_marginTop="@dimen/group_app_status_margin_top"
        android:contentDescription="@string/desc_app_status"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_name" />

</androidx.constraintlayout.widget.ConstraintLayout>